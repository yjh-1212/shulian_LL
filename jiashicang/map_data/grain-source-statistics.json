      ],
      "grainEstimates": {
        "rice": {
          "value": 11.1,
          "method": "总产707.45减去玉米398.77、大豆182.76、小麦71.49和马铃薯折粮35.90，余量18.53万吨；暂按60%分配给稻谷，其余保留为其他粮食。60%为本次结构估算假设。",
          "formula": "(707.45 - 398.77 - 182.76 - 71.49 - 35.90) × 0.60",
          "sourceIds": [
            "hlbe-2025"
          ],
          "uncertainty": "未取得完整稻谷面积与单产，可信度较低；不能将全部剩余粮食视为稻谷。"
        }
